#!/usr/local/munkireport/munkireport-python3

import plistlib
import re
import subprocess
import os
import sys
import time
import platform
try:
    import requests
except ImportError:
    requests = None

# skip this script for now
# sys.exit(0)

sys.path.insert(0, '/usr/local/munki')
sys.path.insert(0, '/usr/local/munkireport')

# Configuration
VERSION = "1.0.7"
# Hours after a successful Adobe contact before the next one. A failure is not recorded, so the next check-in tries again.
ADOBE_REMOTE_HOURS = 6
AU_LIST_TIMEOUT = 120
RUM_LIST_TIMEOUT = 300

# SAP codes RUM does not reliably cover. Never treat "not listed" as up to date.
RUM_ASSUME_CURRENT_EXCLUDE = {
    'KCCC',   # Creative Cloud Desktop — helpx path only
    'PSE', 'PRE', 'HPRE', 'HPSE', 'EORG', 'ECR',  # Elements family
}

def run_command(command, timeout=None):
    # Split command string into array if it's a string, otherwise use as-is
    if isinstance(command, str):
        command = command.split()

    try:
        # Use shell=False for security - prevents command injection
        result = subprocess.run(
            command,
            shell=False,
            capture_output=True,
            text=True,
            timeout=timeout,
        )
    except subprocess.TimeoutExpired as e:
        print(
            f"Timeout running '{' '.join(command)}' after {timeout}s",
            file=sys.stderr,
        )
        stdout = e.stdout or ''
        if isinstance(stdout, bytes):
            stdout = stdout.decode(errors='replace')
        return stdout.strip(), -1
    except (OSError, PermissionError) as e:
        print(f"Error running '{' '.join(command)}': {e}", file=sys.stderr)
        return '', -1

    # Only print error if return code is not 0, 1, or 2
    if result.returncode not in (0, 1, 2):
        print(f"Error running '{' '.join(command)}': {result.stderr}", file=sys.stderr)
    return result.stdout.strip(), result.returncode

def remote_fetch_is_fresh(fetched_at):
    """True when a successful Adobe contact is still inside ADOBE_REMOTE_HOURS."""
    try:
        fetched_at = float(fetched_at)
    except (TypeError, ValueError):
        return False
    if fetched_at <= 0:
        return False
    now = time.time()
    # Clock skew / future stamp must not suppress retries forever.
    if fetched_at > now + 60:
        return False
    return (now - fetched_at) < (ADOBE_REMOTE_HOURS * 3600)

def empty_remote_cache():
    return {
        'rum_list': [],
        'rum_fetched_at': 0,
        'ccd_version': '',
        'ccd_fetched_at': 0,
    }

def load_remote_cache(cache_file):
    if not os.path.exists(cache_file):
        return empty_remote_cache()
    try:
        with open(cache_file, 'rb') as plist_file:
            data = plistlib.load(plist_file)
    except Exception as e:
        print(f"Failed to read Adobe remote cache: {e}", file=sys.stderr)
        return empty_remote_cache()
    if not isinstance(data, dict):
        return empty_remote_cache()
    remote = empty_remote_cache()
    rum_list = data.get('rum_list')
    if isinstance(rum_list, list):
        remote['rum_list'] = rum_list
    remote['rum_fetched_at'] = data.get('rum_fetched_at') or 0
    remote['ccd_version'] = data.get('ccd_version') or ''
    remote['ccd_fetched_at'] = data.get('ccd_fetched_at') or 0
    return remote

def save_remote_cache(cache_file, remote):
    try:
        with open(cache_file, 'wb') as plist_file:
            plistlib.dump(remote, plist_file)
    except Exception as e:
        print(f"Failed to write Adobe remote cache: {e}", file=sys.stderr)

def rum_list_succeeded(output):
    """Return Code (0) is a completed list. Code 1 is a generic failure. Code 2 is partial."""
    return re.search(r'RemoteUpdateManager exiting with Return Code \(0\)', output) is not None

def fetch_rum_list():
    output, _returncode = run_command(
        ['/usr/local/bin/RemoteUpdateManager', '--action=list'],
        timeout=RUM_LIST_TIMEOUT,
    )
    success = rum_list_succeeded(output)
    filtered = "\n".join(
        line for line in output.splitlines()
        if not re.match(r"RemoteUpdateManager exiting with Return Code \((0|1|2)\)", line)
    )
    return parse_rum_data(filtered), success


def overlay_rum_list(cached_list, partial_list):
    """Merge a partial RUM list onto the cached complete list by sapcode."""
    by_sap = {}
    for item in cached_list or []:
        if isinstance(item, dict) and item.get('sapcode'):
            by_sap[item['sapcode']] = item
    for item in partial_list or []:
        if isinstance(item, dict) and item.get('sapcode'):
            by_sap[item['sapcode']] = item
    return list(by_sap.values())

def normalize_version(version_string):
    """Normalize version string for comparison"""
    if not version_string:
        return []
    
    # Remove any non-numeric/dot characters and split by dots
    version_parts = re.sub(r'[^\d.]', '', version_string).split('.')
    
    # Convert to integers, defaulting to 0 for missing parts
    normalized = []
    for part in version_parts:
        try:
            normalized.append(int(part))
        except ValueError:
            normalized.append(0)
    
    return normalized

def compare_versions(version1, version2):
    """Compare two version strings. Returns: -1 if v1 < v2, 0 if equal, 1 if v1 > v2"""
    if not version1 or not version2:
        return None  # Can't compare if either is empty
    
    v1_parts = normalize_version(version1)
    v2_parts = normalize_version(version2)
    
    # Pad shorter version with zeros
    max_length = max(len(v1_parts), len(v2_parts))
    v1_parts.extend([0] * (max_length - len(v1_parts)))
    v2_parts.extend([0] * (max_length - len(v2_parts)))
    
    for i in range(max_length):
        if v1_parts[i] < v2_parts[i]:
            return -1
        elif v1_parts[i] > v2_parts[i]:
            return 1
    
    return 0


def set_update_status(item):
    """Set is_up_to_date from installed vs latest. Empty string means unknown."""
    installed_version = item.get('installed_version') or ''
    latest_version = item.get('latest_version') or ''
    if installed_version and latest_version:
        comparison = compare_versions(installed_version, latest_version)
        if comparison is not None:
            item['is_up_to_date'] = comparison >= 0
            return
    item['is_up_to_date'] = ''


def au_output_has_header(au_data):
    """True when AdobeUninstaller --list output includes the expected column header."""
    if not au_data or not str(au_data).strip():
        return False
    for line in str(au_data).splitlines():
        lower = line.lower()
        if 'sap' in lower and 'version' in lower:
            return True
    return False


def parse_au_data(au_data):
    """
    Parse AdobeUninstaller --list output.
    Returns (au_list, parse_ok). parse_ok is False when the output format is unexpected.
    """
    if not au_data or not str(au_data).strip():
        return [], False

    if not au_output_has_header(au_data):
        return [], False

    lines = au_data.strip().split("\n")
    # Header-only / empty inventory still counts as a successful parse.
    if len(lines) <= 3:
        return [], True

    lines = lines[2:-1]  # Skip the first two lines and the last line

    au_list = []
    for line in lines:
        if line.strip() == "":  # Skip any empty lines
            continue
        parts = line.split()
        if len(parts) < 4:  # Need at least 4 parts: app_name sapcode base_version installed_version
            continue

        sapcode = parts[-3]
        base_version = parts[-2]
        installed_version = parts[-1]
        app_name = ' '.join(parts[:-3])

        au_list.append({
            'app_name': app_name,
            'sapcode': sapcode,
            'base_version': base_version,
            'installed_version': installed_version,
            'latest_version': '',
            'description': '',
            'is_up_to_date': ''
        })
    return au_list, True

def parse_rum_data(rum_data):
    rum_list = []
    lines = rum_data.strip().split("\n")
    for line in lines:
        match = re.search(r'\(([^/]+)/([^/]+)/([^\)]+)\)', line)
        if match:
            sapcode, latest_version, description = match.groups()
            rum_list.append({
                'sapcode': sapcode,
                'latest_version': latest_version,
                'description': description
            })
    return rum_list

def merge_data(au_list, rum_list, rum_list_trusted=False):
    """
    Merge installed apps with RUM latest versions.

    rum_list_trusted: True only after a successful RUM list (return code 0),
    including a still-fresh cached successful list. Never True for failed/partial
    runs. When trusted, an installed app that RUM did not list is treated as
    current (latest_version = installed_version) so the server stores Yes.
    """
    rum_sapcodes = {item['sapcode'] for item in rum_list}
    au_sapcodes = {item['sapcode'] for item in au_list}

    for au_item in au_list:
        # Creative Cloud Desktop is updated via helpx, not RUM.
        if au_item['sapcode'] == 'KCCC':
            continue

        if au_item['sapcode'] in rum_sapcodes:
            # App is mentioned in RUM — use RUM's latest version.
            best_match = None
            for rum_item in rum_list:
                if au_item['sapcode'] == rum_item['sapcode']:
                    au_major = au_item['base_version'].split('.')[0] if au_item['base_version'] else None
                    rum_major = rum_item['latest_version'].split('.')[0] if rum_item['latest_version'] else None

                    if au_major and rum_major and au_major == rum_major:
                        best_match = rum_item
                        break
                    elif not best_match:
                        best_match = rum_item

            if best_match:
                au_item['latest_version'] = best_match['latest_version']
                au_item['description'] = best_match['description']
            else:
                print(
                    f"Warning: No match found for {au_item['app_name']} "
                    f"{au_item['sapcode']} {au_item['base_version']}",
                    file=sys.stderr,
                )
                au_item['latest_version'] = ''
                au_item['description'] = ''
            set_update_status(au_item)
            continue

        # Not listed by RUM.
        sap = au_item.get('sapcode') or ''
        installed = au_item.get('installed_version') or ''
        if (
            rum_list_trusted
            and sap not in RUM_ASSUME_CURRENT_EXCLUDE
            and installed
        ):
            # Successful RUM list omitted this app → no update offered.
            # Mirror installed as latest so server-side compare stores Yes.
            au_item['latest_version'] = installed
            au_item['description'] = ''
            set_update_status(au_item)
        else:
            # Failed/partial/never-succeeded RUM, or excluded SAP → Unknown.
            au_item['latest_version'] = ''
            au_item['description'] = ''
            au_item['is_up_to_date'] = ''

    # Apps that appear in RUM but not in AU (missing from AdobeUninstaller)
    for rum_item in rum_list:
        if rum_item['sapcode'] not in au_sapcodes and rum_item['sapcode'] != 'KCCC':
            au_list.append({
                'app_name': rum_item['sapcode'],
                'sapcode': rum_item['sapcode'],
                'base_version': '',
                'installed_version': '',
                'latest_version': rum_item['latest_version'],
                'description': rum_item['description'],
                'is_up_to_date': ''
            })

    return au_list

def clean_data_for_plist(data):
    """Convert None values to empty strings for plist compatibility"""
    cleaned_data = []
    for item in data:
        cleaned_item = {}
        for key, value in item.items():
            if value is None:
                cleaned_item[key] = ''
            elif isinstance(value, bool):
                cleaned_item[key] = value  # Keep booleans as-is
            else:
                cleaned_item[key] = str(value) if value is not None else ''
        cleaned_data.append(cleaned_item)
    return cleaned_data

# Friendly names for Adobe SAP codes. Used when RUM lists an update with no
# AdobeUninstaller match (placeholder rows used to store sapcode as app_name).
SAP_APP_NAMES = {
    'ACR': 'Camera Raw plugin',
    'AEFT': 'After Effects',
    'AICY': 'InCopy',
    'AME': 'Media Encoder',
    'AUDT': 'Audition',
    'CCXP': 'Creative Cloud Experience',
    'CHAR': 'Character Animator',
    'COSY': 'Core Sync',
    'DRWV': 'Dreamweaver',
    'ECR': 'Camera Raw Elements',
    'EORG': 'Elements Organizer',
    'ESHR': 'Dimension',
    'FLPR': 'Animate',
    'FRSC': 'Fresco',
    'HPRE': 'Premiere Elements Welcome Screen',
    'HPSE': 'Photoshop Elements Welcome Screen',
    'IDSN': 'InDesign',
    'ILST': 'Illustrator',
    'KBRG': 'Bridge',
    'KCCC': 'Creative Cloud Desktop',
    'LRCC': 'Lightroom',
    'LTRM': 'Lightroom Classic',
    'PHSP': 'Photoshop',
    'PPRO': 'Premiere Pro',
    'PRE': 'Premiere Elements',
    'PRLD': 'Prelude',
    'PSE': 'Photoshop Elements',
    'RUSH': 'Premiere Rush',
    'SBSTA': 'Substance 3D Sampler',
    'SBSTD': 'Substance 3D Designer',
    'SBSTP': 'Substance 3D Painter',
    'SHPR': 'Substance 3D Modeler',
    'SPRK': 'XD',
    'STGR': 'Substance 3D Stager',
}


def looks_like_sapcode(name):
    """True when name is empty or an uppercase SAP-style token."""
    name = (name or '').strip()
    if not name:
        return True
    return re.fullmatch(r'[A-Z][A-Z0-9]{1,7}', name) is not None


def resolve_app_name(sapcode, app_name):
    """Prefer a real product name over a raw SAP code placeholder."""
    sapcode = (sapcode or '').strip()
    mapped = SAP_APP_NAMES.get(sapcode, '')
    if mapped and looks_like_sapcode(app_name):
        return mapped
    # Keep known short AU names tidy
    if sapcode == 'PPRO' and (app_name or '').strip() in ('Premiere', 'Adobe Premiere'):
        return 'Premiere Pro'
    return app_name


def update_app_names(data):
    """Replace SAP-code placeholders with friendly application names."""
    for item in data:
        item['app_name'] = resolve_app_name(item.get('sapcode', ''), item.get('app_name', ''))
    return data

def get_acrobat_reader_version():
    """Get Acrobat version from Info.plist using defaults command"""
    # Check various possible Acrobat installation paths
    possible_paths = [
        '/Applications/Adobe Acrobat DC/Adobe Acrobat.app/Contents/Info.plist',
        '/Applications/Adobe Acrobat 8 Professional/Adobe Acrobat Professional.app/Contents/Info.plist',
        '/Applications/Adobe Acrobat 9 Pro/Adobe Acrobat Pro.app/Contents/Info.plist',
        '/Applications/Adobe Acrobat X Pro/Adobe Acrobat Pro.app/Contents/Info.plist'
    ]
    
    for info_plist_path in possible_paths:
        if os.path.exists(info_plist_path):
            try:
                result = subprocess.run(['defaults', 'read', info_plist_path, 'CFBundleShortVersionString'], 
                                      capture_output=True, text=True, timeout=10)
                if result.returncode == 0:
                    return result.stdout.strip()
                else:
                    print(f"defaults read failed for {info_plist_path} with return code {result.returncode}: {result.stderr}", file=sys.stderr)
            except Exception as e:
                print(f"Failed to get Acrobat version from {info_plist_path}: {e}", file=sys.stderr)
    
    print(f"Acrobat Info.plist not found in any of the expected locations", file=sys.stderr)
    return None



def get_latest_ccd_version():
    """Fetch the latest Creative Cloud Desktop version for the current architecture."""
    # Determine architecture
    machine = platform.machine()
    if machine in ("arm64", "aarch64"):
        arch = "macarm64"
    else:
        arch = "osx10"
    url = "https://helpx.adobe.com/download-install/apps/download-install-apps/creative-cloud-apps/download-creative-cloud-desktop-app-using-direct-links.html"
    try:
        if requests is None:
            import urllib.request
            # Add timeout to prevent hanging requests
            import socket
            socket.setdefaulttimeout(10)
            html = urllib.request.urlopen(url).read().decode()
        else:
            html = requests.get(url, timeout=10).text
        # Extract all hrefs ending in .dmg
        href_dmg_urls = re.findall(r'href=[\'\"]([^\'\"]+\.dmg)[\'\"]', html, re.IGNORECASE)
        # Filter for arch and ACCCx
        filtered = [url for url in href_dmg_urls if arch in url and 'ACCCx' in url]
        if not filtered:
            return None
        dmg_url = filtered[0]
        # Extract version
        vmatch = re.search(r'ACCCx([0-9_]+)', dmg_url)
        if not vmatch:
            return None
        version = vmatch.group(1).split('_')
        version = '.'.join(version[:3])  # Use first 3 parts
        return version
    except Exception as e:
        print(f"Failed to fetch CCD version: {e}", file=sys.stderr)
        return None

# Set up cache directory and output file
script_dir = os.path.dirname(os.path.realpath(__file__))
cachedir = os.path.join(script_dir, 'cache')
output_plist = os.path.join(cachedir, 'adobe.plist')
remote_cache_plist = os.path.join(cachedir, 'adobe_remote.plist')

# Security check: ensure cache directory is within script directory
if not cachedir.startswith(script_dir):
    print("Security error: Invalid cache directory path", file=sys.stderr)
    sys.exit(1)

os.makedirs(cachedir, exist_ok=True)

adobe_uninstaller_path = '/usr/local/bin/AdobeUninstaller'
remote_update_manager_path = '/usr/local/bin/RemoteUpdateManager'

if not os.path.exists(adobe_uninstaller_path):
    print(f"AdobeUninstaller not found at {adobe_uninstaller_path}. Please install AdobeUninstaller to use this module.", file=sys.stderr)
    sys.exit(0)

# Installed apps are read on every check-in. This does not contact Adobe.
au_output, au_returncode = run_command(
    [adobe_uninstaller_path, '--list'],
    timeout=AU_LIST_TIMEOUT,
)
au_list, au_parse_ok = parse_au_data(au_output)
# A failed, timed-out, empty, or unparseable list must not replace the saved report.
# Exit 0 with a recognized header and no app rows is a real "nothing installed" result.
if not au_parse_ok or (au_returncode != 0 and not au_list):
    print("AdobeUninstaller --list failed. Keeping the previous Adobe report.", file=sys.stderr)
    sys.exit(0)

remote = load_remote_cache(remote_cache_plist)
rum_list = remote['rum_list']
# Trusted only from a successful RUM list (live or still-fresh cache).
rum_list_trusted = remote_fetch_is_fresh(remote.get('rum_fetched_at'))

# Ask Adobe for latest versions only after a successful contact is 6 hours old.
# A failure leaves rum_fetched_at unchanged, so the next check-in tries again.
if not rum_list_trusted:
    if not os.path.exists(remote_update_manager_path):
        print(f"RemoteUpdateManager not found at {remote_update_manager_path}. Please install RemoteUpdateManager to use this module.", file=sys.stderr)
    else:
        fresh_rum_list, rum_ok = fetch_rum_list()
        if rum_ok:
            rum_list = fresh_rum_list
            remote['rum_list'] = fresh_rum_list
            remote['rum_fetched_at'] = int(time.time())
            rum_list_trusted = True
        elif fresh_rum_list:
            # Partial list: overlay onto cache for this run; do not mark success
            # and do not treat unlisted apps as up to date.
            rum_list = overlay_rum_list(rum_list, fresh_rum_list)
            remote['rum_list'] = rum_list
            rum_list_trusted = False

has_kccc = any(item.get('sapcode') == 'KCCC' for item in au_list)
if has_kccc and not remote_fetch_is_fresh(remote.get('ccd_fetched_at')):
    latest_ccd_version = get_latest_ccd_version()
    if latest_ccd_version:
        remote['ccd_version'] = latest_ccd_version
        remote['ccd_fetched_at'] = int(time.time())

ccd_version = remote.get('ccd_version') or ''
if has_kccc and ccd_version:
    for au_item in au_list:
        if au_item.get('sapcode') == 'KCCC':
            au_item['latest_version'] = ccd_version
            set_update_status(au_item)

save_remote_cache(remote_cache_plist, remote)

merged_data = merge_data(au_list, rum_list, rum_list_trusted=rum_list_trusted)
merged_data = update_app_names(merged_data)
clean_data = clean_data_for_plist(merged_data)

try:
    tmp_plist = output_plist + '.tmp'
    with open(tmp_plist, 'wb') as plist_file:
        plistlib.dump(clean_data, plist_file)
    os.replace(tmp_plist, output_plist)
except Exception as e:
    print(f"Failed to write plist: {e}", file=sys.stderr)
    try:
        if os.path.exists(output_plist + '.tmp'):
            os.remove(output_plist + '.tmp')
    except OSError:
        pass
    sys.exit(1)


